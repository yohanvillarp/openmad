# Entorno de ejecución (development | production | test)
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Origen permitido para CORS (usar comma-separated o '*' para desarrollo)
CORS_ORIGIN=*

# Limitador de tasa de peticiones (Throttler)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Base de Datos PostgreSQL (Prisma)
# Formato: postgresql://USUARIO:CONTRASENA@HOST:PUERTO/NOMBRE_BD?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/openmad_db?schema=public"
