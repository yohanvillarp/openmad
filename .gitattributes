# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Force specific files to LF
*.sh text eol=lf
*.bash text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.prisma text eol=lf
Makefile text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.gitmessage text eol=lf
.editorconfig text eol=lf
.lintstagedrc.json text eol=lf
turbo.json text eol=lf

# Windows batch and command files require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
